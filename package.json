{
  "name": "gridline",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://leo0331.github.io/Gridline",
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^12.6.3",
    "react": "^17.0.1",
    "react-dom": "^19.3.0",
    "react-scripts": "^5.0.1",
    "web-vitals": "^6.2.3"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "node scripts/dev.js",
    "api": "node server/index.js",
    "ingest": "node server/cli.js ingest",
    "snapshot": "node server/export-static-snapshot.js",
    "demo:check": "node scripts/verify-demo-snapshot.js",
    "test:api": "node --test server/*.test.js server/**/*.test.js",
    "test:workflows": "node --test scripts/publish-snapshot.test.js scripts/workflow-summary.test.js scripts/workflow-config.test.js",
    "test:security-gate": "node --test scripts/security-audit.test.js scripts/dependency-exposure.test.js",
    "security:audit": "node scripts/security-audit.js",
    "test:dev-server": "node --test scripts/dev-server-config.test.js",
    "health:supabase": "node scripts/supabase-health.js",
    "test:supabase-health": "node --test scripts/supabase-health.test.js",
    "test:unit": "react-scripts test --watchAll=false --runInBand",
    "verify": "npm run test:dev-server && npm run test:supabase-health && npm run test:workflows && npm run test:security-gate && npm run test:api && npm run test:unit && npm run build",
    "verify:demo": "npm run verify && npm run demo:check",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "proxy": "http://localhost:8787",
  "overrides": {
    "webpack-dev-server": "^5.2.6",
    "loader-utils": "^2.0.4",
    "serialize-javascript": "^7.0.0",
    "nth-check": "^2.1.1",
    "postcss": "^8.4.31",
    "postcss-selector-parser": "7.1.6",
    "svgo": "^2.8.0",
    "ansi-regex": "^5.0.1",
    "decode-uri-component": "^0.2.2",
    "qs": "6.16.0",
    "uuid": "11.1.1",
    "@tootallnate/once": "2.0.1"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
