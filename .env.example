# Never commit real keys. Copy this file to .env.local or export variables in your shell.
SEC_USER_AGENT=Gridline/0.1 research@example.com
EIA_API_KEY=
PJM_API_KEY=
FERC_API_KEY=
# JSON map of ticker to official RSS/Atom URLs, for example:
# COMPANY_IR_FEEDS={"ORCL":"https://example.com/oracle/rss.xml"}
COMPANY_IR_FEEDS={}
# Defaults to every company in src/data/companyExposure.json (20 symbols).
# Optional supported subset, e.g. TICKERS=NBIS,CRWV,BE
# Market history uses Stooq first. If that feed is empty, stale, or undersized,
# Gridline falls back to the Yahoo Finance chart endpoint. For production, replace
# these with approved/licensed endpoints that expose equivalent daily history.
PRICE_BASE_URL=https://stooq.com/q/d/l/
PRICE_FALLBACK_BASE_URL=https://query1.finance.yahoo.com/v8/finance/chart
# Local API scheduler checks daily after 4:15 PM ET; price requests skip non-trading days.
SCHEDULE_ENABLED=true
HOST=127.0.0.1
# Required for non-loopback callers of state-changing API endpoints. Generate a long random value.
API_WRITE_TOKEN=
ALLOWED_ORIGINS=http://localhost:3000,https://leo0331.github.io
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_PUBLISHABLE_KEY=
# Public research defaults. company-ir, pjm and ferc are optional experimental adapters.
SCHEDULE_SOURCES=sec,prices,eia,events,company-research
